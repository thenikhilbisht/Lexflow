# =========================================================
# LexFlow / LexiGuide AI Legal Platform - Environment Config
# =========================================================

# 1. Google Gemini API Key (Optional)
# If provided, enables live Gemini 1.5 Flash remote AI generation.
# If omitted, the platform automatically runs on local hybrid BM25 RAG.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# 2. Session Security Secret (Recommended for Production)
# Random secret string used to sign session cookies (HMAC-SHA256).
SESSION_SECRET=lexflow-production-super-secret-key-2026-auth-protection

# 3. Application Domain / URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Environment Mode
NODE_ENV=development
